{
  "name": "contributor-cloudflare-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint",
    "commitlint:history": "node scripts/lint-commit-history.mjs",
    "dev": "wrangler dev",
    "types": "wrangler types",
    "build": "npm run types && tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:gates": "node --test tests/gates/reports.test.mjs",
    "audit:performance": "node scripts/check-performance.mjs",
    "check:bundle": "wrangler deploy --dry-run --outdir dist && node scripts/check-bundle.mjs",
    "test:watch": "vitest",
    "check": "npm run build && npm run lint && npm run format:check && npm run test:coverage && npm run test:gates",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "smoke": "node scripts/smoke.mjs",
    "template:configure": "node scripts/configure-template.mjs",
    "template:check": "node scripts/check-template.mjs"
  },
  "cloudflare": {
    "bindings": {
      "APP_NAME": {
        "description": "Public title shown on the welcome page. No secrets or external services are required."
      }
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vitest-plugin": "1.4.6",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-istanbul": "5.0.5",
    "chrome-launcher": "1.2.2",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dasarpemrograman/contributor-cloudflare-starter.git"
  }
}
